# RR Engenharia — Apache Configuration

# Enable Rewrite Engine
RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Remove www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# 301 Redirects — URLs antigas (estrutura anterior do site) para as novas.
# Recupera o histórico de SEO e elimina os erros 404 no Search Console.
RewriteRule ^servicos/instalacao-sasc/?$        /servicos/sasc.html [R=301,L]
RewriteRule ^servicos/teste-estanqueidade/?$    /servicos/teps.html [R=301,L]
RewriteRule ^blog/o-que-e-sasc/?$               /blog/o-que-e-sasc-guia-completo.html [R=301,L]
RewriteRule ^blog/teps-ensaios-estanqueidade/?$ /blog/inspecao-teps-o-que-sua-empresa-precisa-saber.html [R=301,L]
RewriteRule ^blog/manutencao-preventiva-sla/?$  /servicos/manutencao-predial.html [R=301,L]
RewriteRule ^blog/obras-postos-combustivel/?$   /servicos/postos-de-combustivel.html [R=301,L]
RewriteRule ^blog/rr-engine-automacao-propostas/?$ /blog/ [R=301,L]
RewriteRule ^contato/?$                          /contato.html [R=301,L]

# Política de privacidade: /privacidade.html redireciona para a URL canônica
# /privacidade, que é servida internamente pelo HTML.
RewriteCond %{THE_REQUEST} \s/privacidade\.html [NC]
RewriteRule ^privacidade\.html$ /privacidade [R=301,L]
RewriteRule ^privacidade/?$                       /privacidade.html [L]

# Custom Error Pages
ErrorDocument 404 /404.html

# Fallback de 404 real: o host ignora o ErrorDocument acima, então qualquer
# caminho que não corresponda a arquivo/diretório existente é servido pelo
# 404.php, que devolve a página personalizada COM status HTTP 404.
RewriteCond %{REQUEST_URI} !^/404\.php$
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /404.php [L]

# GZIP Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE application/xml
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  # HTML não é cacheado: o navegador sempre revalida, então mudanças no
  # conteúdo aparecem na hora. Imagens/CSS/JS mantêm cache longo (têm ?v=).
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType application/json "access plus 1 day"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType video/webm "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

# Cache-Control explícito para estáticos versionados por ?v= (GoDaddy nem sempre
# aplica mod_expires; este bloco garante o cabeçalho)
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|jpe?g|png|webp|svg|mp4|webm|woff2?)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>

# HTML sempre revalidado (evita servir página desatualizada após deploy)
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always unset X-XSS-Protection
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # HSTS: 1 ano, sem includeSubDomains até auditar todos os subdomínios
  Header always set Strict-Transport-Security "max-age=31536000"
  # CSP em Report-Only: observar por 2 semanas antes de migrar para enforce
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://snap.licdn.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://www.google-analytics.com https://px.ads.linkedin.com https://www.googletagmanager.com; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://px.ads.linkedin.com https://api.web3forms.com; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://api.web3forms.com; frame-ancestors 'self'"
</IfModule>

# Bloqueia arquivos sensíveis (logs, backups, configs) em toda a árvore
<FilesMatch "\.(log|env|ini|bak|sql|sh|zip|tar|gz)$">
  Require all denied
</FilesMatch>

# Prevent directory listing
Options -Indexes

# UTF-8 encoding
AddDefaultCharset UTF-8

# MIME types
AddType image/svg+xml .svg .svgz
AddType application/json .json
AddType text/xml .xml

# deploy: reexecução após timeout FTPS em 19/08/2026
